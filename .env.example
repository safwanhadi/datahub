DJANGO_SECRET_KEY=ganti-dengan-random-secret-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=datahub.rsmandalika.com

# DataHub meminta opaque token untuk membaca JSON PHP/SIMRS.
SIMADU_TOKEN_URL=https://simadu.rsmandalika.com/o/token/
SIMADU_CLIENT_ID=datahub-simrs-reader
SIMADU_CLIENT_SECRET=ganti-dengan-secret-dari-simadu
SIMADU_SIMRS_SCOPE=simrs.indicators.read
SIMRS_INDICATOR_API_URL=https://simrs-internal/api/data_indikator_ranap.php

# DataHub mengintrospeksi opaque token milik aplikasi pihak ketiga.
SIMADU_INTROSPECTION_URL=https://simadu.rsmandalika.com/o/introspect/
SIMADU_INTROSPECTION_CLIENT_ID=datahub-resource-server
SIMADU_INTROSPECTION_CLIENT_SECRET=ganti-dengan-secret-introspection
DATAHUB_API_REQUIRED_SCOPE=datahub.indicators.read
SIMADU_ALLOWED_API_CLIENTS=dinkes-datahub-reader
SIMADU_OAUTH_TIMEOUT=10
SIMADU_INTROSPECTION_CACHE_SECONDS=30
